# Resend API Key - Get yours at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Email address that will receive contact form notifications
RESEND_TO_EMAIL=votre@email.com

# Sender address (must belong to a domain verified in Resend)
RESEND_FROM_EMAIL=contact@location-ile-aux-moines.fr

# Set to "false" to disable the confirmation email sent to the guest
RESEND_CONFIRMATION=true

# Extra iCal hosts allowed for contact.airbnbUrl, comma-separated (https Airbnb hosts are always allowed)
ICAL_ALLOWED_HOSTS=

# Behind a reverse proxy: header(s) carrying the visitor IP, e.g. X-Forwarded-For or CF-Connecting-IP (Cloudflare)
# Required for the per-IP rate limits; leave empty when PocketBase is exposed directly
TRUSTED_PROXY_HEADERS=

# Admin two-factor login (password + code sent by email through Resend's SMTP relay).
# Set to false and restart only if the admin mailbox is unreachable
ADMIN_MFA=true
